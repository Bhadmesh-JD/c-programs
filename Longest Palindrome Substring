#include <string.h>

// Helper function to expand around a center and return the length of the palindrome
int expandAroundCenter(char* s, int left, int right) {
    while (left >= 0 && s[right] != '\0' && s[left] == s[right]) {
        left--;
        right++;
    }
    // Returns the length of the valid palindrome found
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    if (s == NULL || s[0] == '\0') {
        return "";
    }

    int start = 0;
    int maxLength = 0;

    for (int i = 0; s[i] != '\0'; i++) {
        // Case 1: Odd length palindromes (e.g., "aba", center is 'b')
        int len1 = expandAroundCenter(s, i, i);
        
        // Case 2: Even length palindromes (e.g., "abba", center is between 'b' and 'b')
        int len2 = expandAroundCenter(s, i, i + 1);

        // Find the maximum of both expansion cases
        int len = len1 > len2 ? len1 : len2;

        // If a longer palindrome is found, update our boundaries
        if (len > maxLength) {
            maxLength = len;
            // Calculate the starting index of this new substring
            start = i - (len - 1) / 2;
        }
    }

    // Terminate the longest palindrome substring safely in place
    s[start + maxLength] = '\0';
    
    return &s[start];
}
