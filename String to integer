#include <limits.h>
#include <stddef.h>

int myAtoi(char* s) {
    if (s == NULL) {
        return 0;
    }

    int i = 0;
    int sign = 1;
    int result = 0;

    // 1. Skip leading whitespaces
    while (s[i] == ' ') {
        i++;
    }

    // 2. Check for sign indicator
    if (s[i] == '+' || s[i] == '-') {
        sign = (s[i] == '-') ? -1 : 1;
        i++;
    }

    // 3. Process numerical digits
    while (s[i] >= '0' && s[i] <= '9') {
        int digit = s[i] - '0';

        // 4. Handle 32-bit signed overflow/underflow bounds check
        if (result > INT_MAX / 10 || (result == INT_MAX / 10 && digit > INT_MAX % 10)) {
            return (sign == 1) ? INT_MAX : INT_MIN;
        }

        result = result * 10 + digit;
        i++;
    }

    return result * sign;
}
